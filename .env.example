# Application
APP_ENV=local
APP_DEBUG=true

# PostgreSQL (used by docker-compose and by the backend settings)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=airtel_sales_assistant
POSTGRES_USER=airtel_app
POSTGRES_PASSWORD=change_me

# Optional override. If set, backend will use this directly.
# Example:
# DATABASE_URL=postgresql+psycopg://airtel_app:change_me@localhost:5432/airtel_sales_assistant
DATABASE_URL=
